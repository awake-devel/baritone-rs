# Makes a scratch copy of mod/engine behave like upstream's 26.3 rules (commit 25111da), one hunk group per rule.
# Apply it to a COPY of the repository's mod/engine, never to the real one:  patch -p1 -F0 < rules-26.3.patch
# It was made against the engine as committed at 2716003. See tools/README.md for how it is used and measured.

# rule: door_walkthrough
# canWalkThroughBlockState: 26.3 passes every door and gate except the iron door; 1.21.4 asks DoorBlock.isWoodenDoor for doors.
--- a/mod/engine/src/movement/helper.rs
+++ b/mod/engine/src/movement/helper.rs
@@ -114,7 +114,4 @@
     }
-    if s.door {
-        return if s.wooden_door { Yes } else { No };
-    }
-    if s.gate {
-        return Yes;
+    if s.door || s.gate {
+        return if s.name == "iron_door" { No } else { Yes };
     }

# rule: diag_blocking_door
# MovementDiagonal.cost: 26.3 has no isBlockingDoor (three places: the early return, the A/B low-cell test, and the +1 on the mining time).
--- a/mod/engine/src/movement/diagonal.rs
+++ b/mod/engine/src/movement/diagonal.rs
@@ -41,6 +41,2 @@
     let start_state = ctx.get(x, y, z);
-    // upstream passes y as the last argument of the second call, where a z coordinate would be expected
-    if is_blocking_door(&start_state, x, z, dest_x, dest_z) || is_blocking_door(if ascend { &dest_into_upper } else { &dest_into }, dest_x, dest_z, x, y) {
-        return; // Easier to just traverse instead
-    }
     let mut multiplier = WALK_ONE_BLOCK_COST;
@@ -94,4 +90,2 @@
         let mut b_low = ctx.can_walk_through(dest_x, y, z, pb2);
-        a_low &= !is_blocking_door(&pb0, x, dest_z, dest_x, z);
-        b_low &= !is_blocking_door(&pb2, dest_x, z, x, dest_z);
         if (!(a_top && a_mid && a_low) && !(b_top && b_mid && b_low)) || avoid_walking_into(&pb0, ctx.cfg) || avoid_walking_into(&pb2, ctx.cfg) || (a_top && a_mid && ctx.can_walk_on(x, y, dest_z, pb0)) || (b_top && b_mid && ctx.can_walk_on(dest_x, y, z, pb2)) || (!a_top && a_mid && a_low) || (!b_top && b_mid && b_low) {
@@ -107,4 +101,2 @@
     let mut option_b = ctx.mining_duration(dest_x, y, z, pb2, false);
-    option_a += if is_blocking_door(&pb0, x, dest_z, dest_x, z) { 1.0 } else { 0.0 };
-    option_b += if is_blocking_door(&pb2, dest_x, z, x, dest_z) { 1.0 } else { 0.0 };
     if option_a != 0.0 && option_b != 0.0 {

# rule: diag_magma_corner
# MovementDiagonal.cost: 26.3 tests cuttingOver1 for magma twice; the second corner (cuttingOver2) is only tested for lava.
--- a/mod/engine/src/movement/diagonal.rs
+++ b/mod/engine/src/movement/diagonal.rs
@@ -71,3 +71,3 @@
     let cutting_over2 = ctx.get(dest_x, y - 1, z);
-    if (!ctx.cfg.allow_walk_on_magma && cutting_over2.block == Block::MagmaBlock) || is_lava(&cutting_over2) {
+    if (!ctx.cfg.allow_walk_on_magma && cutting_over1.block == Block::MagmaBlock) || is_lava(&cutting_over2) {
         return;

# rule: diag_ascend_jump_penalty
# MovementDiagonal.cost: 26.3 does not add jumpPenalty to a diagonal ascend.
--- a/mod/engine/src/movement/diagonal.rs
+++ b/mod/engine/src/movement/diagonal.rs
@@ -99,3 +99,3 @@
         }
-        res.cost = multiplier * SQRT_2 + jump_one_block_cost() + ctx.cfg.jump_penalty;
+        res.cost = multiplier * SQRT_2 + jump_one_block_cost();
         res.x = dest_x;

