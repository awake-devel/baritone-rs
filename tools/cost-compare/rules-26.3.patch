# rule: swimming
# CalculationContext constructor: 26.3 has no allowSwimming and no SWIM_ONE_BLOCK_COST cap on the water walk speed.
--- a/mod/engine/src/movement/helper.rs
+++ b/mod/engine/src/movement/helper.rs
@@ -265,3 +265,3 @@
         let mut water_speed = WALK_ONE_IN_WATER_COST * ((1.0f32 - mult) as f64) + WALK_ONE_BLOCK_COST * (mult as f64);
-        if cfg.allow_swimming && cfg.can_sprint {
+        if false && cfg.allow_swimming && cfg.can_sprint {
             water_speed = java_min(water_speed, SWIM_ONE_BLOCK_COST);

# rule: runaway_max
# GoalRunAway.heuristic(): 26.3 has maxX = Math.max(minX, ...) (and the same for Y and Z), so its scan box can be too small.
--- a/mod/engine/src/goals.rs
+++ b/mod/engine/src/goals.rs
@@ -322,5 +322,5 @@
                     min_z = min_z.min(p.2.wrapping_sub(distance));
-                    max_x = max_x.max(p.0.wrapping_add(distance));
-                    max_y = max_y.max(p.1.wrapping_add(distance));
-                    max_z = max_z.max(p.2.wrapping_add(distance));
+                    max_x = min_x.max(p.0.wrapping_add(distance));
+                    max_y = min_y.max(p.1.wrapping_add(distance));
+                    max_z = min_z.max(p.2.wrapping_add(distance));
                 }

