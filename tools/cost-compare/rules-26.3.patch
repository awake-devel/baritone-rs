# rule: wl_pillar
# MovementPillar.cost: 26.3 does not exempt a waterlogged solid top below from the assumeWalkOnWater test.
--- a/mod/engine/src/movement/pillar.rs
+++ b/mod/engine/src/movement/pillar.rs
@@ -42,3 +42,3 @@
     }
-    if (is_liquid(&from_state) && !ctx.can_place_against(x, y - 1, z)) || (is_liquid(&from_down) && !is_waterlogged_solid_top(&from_down) && ctx.cfg.assume_walk_on_water) {
+    if (is_liquid(&from_state) && !ctx.can_place_against(x, y - 1, z)) || (is_liquid(&from_down) && ctx.cfg.assume_walk_on_water) {
